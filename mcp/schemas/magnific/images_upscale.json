{"name":"images_upscale","description":"AI upscale 2x–16x (Magnific, premium): improve sharpness, quality and detail of an existing image while keeping its content intact. Call `images_upscale_modes_list` first to pick a `mode` and discover per-mode params. Defaults: mode=creative, scale=2x. Exact pixels: `images_resize`. Aspect: `images_crop`.","parameters":{"properties":{"creationIdentifier":{"description":"Image creation identifier (import uploads first).","type":"string"},"creativity":{"description":"Creative; -10..10.","type":"integer"},"engine":{"description":"Creative engine; default automatic.","enum":["automatic","magnific_illusio","magnific_sharpy","magnific_sparkle"],"type":"string"},"folderReference":{"description":"From `folders_list`. Omit → the user's Personal project (refused if `disabled`). Does NOT persist: once the user names a target, pass it on EVERY later generation/edit call.","type":"string"},"fractality":{"description":"Creative; -10..10.","type":"integer"},"grain":{"description":"Precision; 0..100.","type":"integer"},"hdr":{"description":"Creative; -10..10.","type":"integer"},"mode":{"description":"From `images_upscale_modes_list`. Default creative.","enum":["creative","ultra-sublime","ultra-photo","ultra-denoiser","ultra"],"type":"string"},"optimised":{"description":"Creative subject-type preset; default StandardUltra.","enum":["StandardUltra","SoftPortrait","HardPortrait","ArtAndIllustration","VideoGameAssets","NatureAndLandscapes","FilmAndPhotography","ThreeDRenders","ScienceFictionAndHorror"],"type":"string"},"precisionPreset":{"description":"Slider macro; requires a precision mode.","enum":["balanced","portraits","grainyAnalog"],"type":"string"},"presets":{"description":"Creative preset; default 'subtle'.","enum":["subtle","vivid","wild","custom"],"type":"string"},"prompt":{"description":"Creative guidance prompt (max 2000 chars).","type":"string"},"resemblance":{"description":"Creative; -10..10.","type":"integer"},"scale":{"descriptio