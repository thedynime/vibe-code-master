{"name":"images_relight","description":"AI relight. 1-4 lights with azimuth/elevation enums, type neutral|gel, intensity 1-10. Gel uses hex `color`.","parameters":{"properties":{"creationIdentifier":{"description":"Image creation identifier (import uploads first).","type":"string"},"folderReference":{"description":"From `folders_list`. Omit → the user's Personal project (refused if `disabled`). Does NOT persist: once the user names a target, pass it on EVERY later generation/edit call.","type":"string"},"lights":{"description":"1-4 lights.","items":{"additionalProperties":false,"properties":{"azimuth":{"description":"Horizontal degrees.","enum":[-135,-90,-45,0,45,90,135,180],"type":"integer"},"color":{"description":"Gel only; hex; default #ffffff.","type":"string"},"elevation":{"description":"Vertical degrees.","enum":[-90,-45,0,45,90],"type":"integer"},"intensity":{"description":"1-10; default 5.","maximum":10,"minimum":1,"type":"integer"},"type":{"description":"Default neutral.","enum":["neutral","gel"],"type":"string"}},"required":["azimuth","elevation"],"type":"object"},"maxItems":4,"minItems":1,"type":"array"},"numImages":{"description":"Default 1.","maximum":2,"minimum":1,"type":"integer"},"resolution":{"description":"Default 2k.","enum":["1k","2k"],"type":"string"}},"required":["creationIdentifier","lights"],"type":"object"}}